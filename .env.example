# Copy to `.env` and fill in. `.env` is git-ignored.
#
# `src/lib/config/env.ts` validates this file on server start and refuses to
# boot with a readable message if something required is missing or malformed.

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elevator_pulse?schema=public"

# ─── Auth (NextAuth.js) ──────────────────────────────────────────
# Required in production — the app will not start without it.
# Generate one:  openssl rand -base64 32
#
# NOTE: this deliberately ships empty rather than with a placeholder value. The
# previous example contained the literal "change-me-in-production", so anyone
# who copied the file and deployed ran with a publicly known session-signing
# key.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Local open access (development only) ────────────────────────
# When "true", every request is treated as a signed-in ADMIN and the login
# screen is skipped, so the app can be browsed without credentials. Useful for
# a quick look at the UI; never set this on a machine reachable by anyone else.
#
# Shipped as "false" and not merely commented out: with open access on, every
# caller is a synthetic ADMIN, so the tenant scoping and the per-route role
# checks are never exercised. The login screen is the only configuration in
# which the authorisation boundary is actually testable.
#
# The check in `src/lib/auth/open-access.ts` returns false unconditionally when
# NODE_ENV=production, so a production build ignores this flag even if it is
# set. Sign in with a seeded demo account (see `prisma/seed.ts`).
OPEN_ACCESS="false"

# ─── Demo data fallback (development only) ───────────────────────
# When "true", a read endpoint that cannot reach PostgreSQL serves an
# in-memory fixture instead of failing, so the UI renders populated screens
# with no database. The fixtures live in `src/lib/demo/`.
#
# Real data always wins: every route runs its genuine query first and only
# falls back on a connection failure (P1001 / P1002 / ECONNREFUSED — never on
# a constraint violation or a malformed query, which must still surface).
#
# Shipped as "false": a fixture cannot validate a Prisma query, and a broken
# connection that renders as a populated screen is worse than an honest 503.
# Run `npm run db:push && npm run db:seed` against a real PostgreSQL.
#
# Ignored unconditionally when NODE_ENV=production, so a deployed build reports
# a database outage as 503 rather than inventing telemetry.
DEMO_DATA="false"

# ─── IoT ingestion ───────────────────────────────────────────────
# Bearer token required on POST /api/telemetry.
# Strongly recommended in production: without it the endpoint accepts
# unauthenticated writes (the server logs a warning at startup). The simulator
# in `scripts/simulate-iot.ts` sends it automatically when set.
IOT_INGEST_TOKEN=""
IOT_SIMULATION_INTERVAL=2000
# API_URL="http://localhost:3000"   # override for the IoT simulator

# ─── Reconduction et alertes d'échéance des contrats ────────────
# Bearer token for POST /api/cron/contracts-rollover. Optional: without it the
# route still accepts a management session, and scripts/contracts-rollover.ts
# remains the path for a system cron.
#
# Set it when a scheduler that has no user account must call the URL. 16
# characters minimum — the route writes contract end dates and notifies every
# management user, so a guessable secret is not an option.
#
# The route also accepts ?dryRun=1: it reads, reports what it would change, and
# writes nothing.
# CONTRACTS_CRON_TOKEN=""

# ─── WhatsApp / Evolution API (escalades et bons de travail) ─────
# The out-of-band channel. Two things travel on it: the escalation alert to
# ADMIN_PHONE_NUMBER below, and — every time a work order is assigned — the job
# itself to the technician's own number, with the site address, a navigation
# link and what the client reported.
#
# LEAVING THESE EMPTY IS A NORMAL STATE, NOT A BROKEN ONE. With none of the three
# set, `src/lib/notifications/whatsapp.ts` does nothing at all: it writes the
# message it would have sent to the server log, answers `no-transport`, and
# fails no caller. Nothing has to be switched off while the instance does not
# exist yet, and nothing breaks the day it does.
#
# ALL THREE OR NONE. Two of three is the one shape that lies: it looks
# configured, and every send silently reports `no-transport` because one
# variable is missing. `src/lib/config/env.ts` warns about exactly that case.

# Base URL of the instance, e.g. "http://127.0.0.1:8080". A trailing slash is
# tolerated. If Evolution runs on the same machine, bind it to the loopback
# address rather than to 0.0.0.0 — an instance reachable from the internet with
# only an API key in front of it is a WhatsApp account waiting to be taken over.
EVOLUTION_API_URL=""

# The instance's API key, sent as the `apikey` header. THIS IS A SECRET: it
# belongs in `.env` on the server and nowhere else. Never in the repository,
# never in a chat message, never in a screenshot. The transport reports what
# Evolution answers but never this value.
EVOLUTION_API_KEY=""

# The instance name, exactly as it appears in the Evolution dashboard.
EVOLUTION_INSTANCE=""

# ─── WhatsApp via Twilio (optionnel, prioritaire sur Evolution) ──
#
# Quand les trois variables ci-dessous sont renseignées, l'envoi passe par
# l'API Messages de Twilio au lieu d'Evolution. Elles sont lues directement
# dans `process.env` : absentes, elles n'empêchent pas le démarrage.
# TWILIO_AUTH_TOKEN est un secret — jamais dans le dépôt.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Numéro expéditeur WhatsApp, format E.164, avec ou sans préfixe "whatsapp:".
# Exemple : "whatsapp:+14155238886" (bac à sable Twilio).
TWILIO_WHATSAPP_FROM=""

# The country code used to complete a number written the local way.
#
# "0661234567" cannot be sent as it stands: those digits mean nothing without a
# country, and sending them anyway is how a message lands on a stranger's phone.
# Set this to "213" and a leading zero is replaced with it. Left empty, a number
# that is not already in international form is refused with `bad-number` rather
# than guessed at.
#
# Digits only, no "+". Leave empty if every technician's number is stored in
# international form ("+213661234567") — which is what the seed does.
WHATSAPP_DEFAULT_COUNTRY_CODE=""

# ─── Alerte WhatsApp d'escalade ──────────────────────────────────
# The number that receives an alert when a client escalates an incident
# ("Passer à l'admin" / "Non Résolu") or presses the emergency button. Uses the
# Evolution instance configured above; with no instance configured, the alert
# is written to the server log and reported as not delivered — nothing reaches
# the phone.
#
# The in-app notification to every manager is sent either way, and it is the
# only channel that always arrives.
#
# International form, e.g. "+213661234567". Free text, passed to the provider
# as written.
ADMIN_PHONE_NUMBER=""

# ─── Mentions portées sur les devis et factures ─────────────────
# L'identité de l'entreprise telle qu'elle s'imprime en tête et en pied de
# chaque document (devis, facture, fiche de pièces). Ces valeurs ne sont
# volontairement pas écrites en dur dans le code : une adresse ou un numéro
# d'identification fiscale inventés produiraient un faux document, et c'est le
# genre de valeur qu'on ne remarque pas avant de l'avoir envoyée à un client.
#
# LAISSER VIDE EST UN ÉTAT NORMAL. Le document s'imprime alors avec le seul nom
# par défaut, sans adresse ni identifiant — jamais avec un texte de
# remplacement. Renseignez-les avant d'envoyer un document pour de vrai.
INVOICE_COMPANY_NAME="SARL RMASC Ascenseurs"
INVOICE_COMPANY_ADDRESS=""
INVOICE_COMPANY_PHONE=""
INVOICE_COMPANY_EMAIL=""

# Les identifiants légaux, imprimés à la suite des coordonnées. Chacun
# n'apparaît que s'il est renseigné : « RC : — » ferait un document incomplet.
INVOICE_COMPANY_RC=""
INVOICE_COMPANY_NIF=""
INVOICE_COMPANY_NIS=""
# Article d'imposition. `INVOICE_COMPANY_TAX_ID` reste lu en repli, pour une
# configuration plus ancienne qui n'aurait que ce champ.
INVOICE_COMPANY_AI=""
INVOICE_COMPANY_TAX_ID=""

# Coordonnées bancaires du pied de page : « Banque : … · RIB : … ».
INVOICE_COMPANY_BANK=""
INVOICE_COMPANY_RIB=""

# Délai de règlement imprimé comme échéance de paiement sur les factures
# (30 jours si la variable est absente ou invalide).
# INVOICE_PAYMENT_TERMS_DAYS="30"

# Mentions légales du pied de page, séparées par « | ». Elles s'impriment en
# bas de *chaque* page, sous les coordonnées bancaires.
# INVOICE_COMPANY_MENTIONS="SARL au capital de … | RC … | NIF … | TVA 19 %"

# Le logo de l'entreprise.
# Déposez le fichier dans `public/brand/` et indiquez ici son chemin public.
# Par défaut : `/brand/rmasc-logo.png`. Un chemin absolu fonctionne pour le PDF
# mais n'est pas servi au navigateur — pour l'avoir aussi à l'écran, gardez un
# chemin public.
# INVOICE_LOGO_PATH="/brand/rmasc-logo.png"

# Le cachet apposé en bas à droite des documents. Par défaut le fichier est
# cherché dans `public/cachet.png`. Tant qu'il est absent, le document s'imprime
# sans tampon : un document sans cachet est une pièce non signée, alors qu'un
# cachet de remplacement serait un document falsifié.
# INVOICE_STAMP_PATH="/chemin/absolu/vers/cachet.png"

# ─── Magasin central (seconde application RMASC) ─────────────────
#
# La transmission d'une demande de pièce vers le magasin central est une
# signature HMAC sur trois en-têtes, et non un appel authentifié par un cookie :
# le magasin central n'a aucune session à nous prêter. Les trois variables vont
# ensemble — en poser deux sur trois produit une configuration qui échoue au
# premier envoi, avec un message qui ne dit pas laquelle manque.
#
# QUAND ELLES SONT ABSENTES, L'ÉCRAN PASSE EN DÉMONSTRATION
# Hors production, l'écran « Magasinier » reste utilisable : un catalogue
# fictif (BR-G-SET, R-6x19-8MM, ECU-V4) remplit les sélecteurs, et chaque envoi
# répond « Transmission simulée avec succès en mode démonstration » sans écrire
# nulle part. Un bandeau d'information le dit en tête de l'écran. Dès que les
# trois variables sont posées, la vraie liaison reprend la main sans rien
# d'autre à changer.
#
# En production, la démonstration est désactivée quoi qu'il arrive : sans
# identifiants, l'écran affiche l'avertissement de configuration et n'offre
# aucun bouton d'envoi. Une transmission simulée en production ferait attendre
# une pièce que personne n'a commandée.
#
# L'ADRESSE SE DONNE EN LOCAL, PAS PAR LE DOMAINE PUBLIC
# Les deux applications tournent sur la même machine. Passer par le tunnel et le
# domaine publics ajouterait le DNS, TLS et la disponibilité de Cloudflare à une
# conversation entre deux processus voisins — et casserait la transmission quand
# le tunnel tombe, alors que les deux applications sont debout.
#
# NE PAS ÉCRIRE DE BARRE FINALE : elle entrerait dans le chemin signé et ferait
# refuser toutes les requêtes.
#
# STOCK_API_URL="http://127.0.0.1:3020"
# STOCK_API_KEY=""      # = EXTERNAL_API_KEY du magasin central
# STOCK_API_SECRET=""   # = EXTERNAL_API_SECRET du magasin central

# ─── Not currently consumed by the application ───────────────────
# Reserved for planned work; nothing in `src/` reads these today. They are
# listed so the gap is explicit rather than implied.
#
# REDIS_URL="redis://localhost:6379"       # no cache/queue layer is wired up yet
# WEBSOCKET_PORT=3001                      # telemetry is polled, not pushed
# PREDICTIVE_API_URL="http://localhost:8000"
# PREDICTIVE_API_KEY=""
