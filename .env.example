# Copy to `.env` and fill in. `.env` is git-ignored.
#
# `src/lib/config/env.ts` validates this file on server start and refuses to
# boot with a readable message if something required is missing or malformed.

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elevator_pulse?schema=public"

# ─── Auth (NextAuth.js) ──────────────────────────────────────────
# Required in production — the app will not start without it.
# Generate one:  openssl rand -base64 32
#
# NOTE: this deliberately ships empty rather than with a placeholder value. The
# previous example contained the literal "change-me-in-production", so anyone
# who copied the file and deployed ran with a publicly known session-signing
# key.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Local open access (development only) ────────────────────────
# When "true", every request is treated as a signed-in ADMIN and the login
# screen is skipped, so the app can be browsed without credentials. Useful for
# a quick look at the UI; never set this on a machine reachable by anyone else.
#
# Shipped as "false" and not merely commented out: with open access on, every
# caller is a synthetic ADMIN, so the tenant scoping and the per-route role
# checks are never exercised. The login screen is the only configuration in
# which the authorisation boundary is actually testable.
#
# The check in `src/lib/auth/open-access.ts` returns false unconditionally when
# NODE_ENV=production, so a production build ignores this flag even if it is
# set. Sign in with a seeded demo account (see `prisma/seed.ts`).
OPEN_ACCESS="false"

# ─── Demo data fallback (development only) ───────────────────────
# When "true", a read endpoint that cannot reach PostgreSQL serves an
# in-memory fixture instead of failing, so the UI renders populated screens
# with no database. The fixtures live in `src/lib/demo/`.
#
# Real data always wins: every route runs its genuine query first and only
# falls back on a connection failure (P1001 / P1002 / ECONNREFUSED — never on
# a constraint violation or a malformed query, which must still surface).
#
# Shipped as "false": a fixture cannot validate a Prisma query, and a broken
# connection that renders as a populated screen is worse than an honest 503.
# Run `npm run db:push && npm run db:seed` against a real PostgreSQL.
#
# Ignored unconditionally when NODE_ENV=production, so a deployed build reports
# a database outage as 503 rather than inventing telemetry.
DEMO_DATA="false"

# ─── IoT ingestion ───────────────────────────────────────────────
# Bearer token required on POST /api/telemetry.
# Strongly recommended in production: without it the endpoint accepts
# unauthenticated writes (the server logs a warning at startup). The simulator
# in `scripts/simulate-iot.ts` sends it automatically when set.
IOT_INGEST_TOKEN=""
IOT_SIMULATION_INTERVAL=2000
# API_URL="http://localhost:3000"   # override for the IoT simulator

# ─── Alerte SMS (escalades) ──────────────────────────────────────
# The number that receives an alert when a client escalates an incident
# ("Passer à l'admin" / "Non Résolu") or presses the emergency button.
#
# READ THIS BEFORE RELYING ON IT: no SMS gateway is wired up yet. With this
# variable set, the alert is *written to the server log* and reported as not
# delivered — nothing reaches the phone. Without it, nothing is even logged.
# See the module header in `src/lib/notifications/sms.ts` for how to attach a
# real provider; the in-app notification to every manager is sent either way
# and is currently the only channel that actually arrives.
#
# Format is free text and is passed to the provider unchanged — use the
# international form, e.g. "+213661234567".
ADMIN_PHONE_NUMBER=""

# ─── Not currently consumed by the application ───────────────────
# Reserved for planned work; nothing in `src/` reads these today. They are
# listed so the gap is explicit rather than implied.
#
# REDIS_URL="redis://localhost:6379"       # no cache/queue layer is wired up yet
# WEBSOCKET_PORT=3001                      # telemetry is polled, not pushed
# PREDICTIVE_API_URL="http://localhost:8000"
# PREDICTIVE_API_KEY=""
