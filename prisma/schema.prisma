// ─────────────────────────────────────────────────────────────
// Maintenance RMASC – Prisma Schema
// Predictive & Preventive Maintenance Platform for Elevators
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MAINTENANCE_MANAGER
  FIELD_TECHNICIAN
  BUILDING_OWNER
}

/// Whether a client account holds a maintenance contract with us.
///
/// This is the column that splits the customer base in two, and the two halves
/// have genuinely different portals rather than different labels:
///
///  - CONTRACTED — the historical customer. We hold their file, their buildings
///    and their elevators. Their portal reports faults against a known unit.
///  - NON_CONTRACTED — no file at all. Their portal is the « Fiche Technique »
///    form, which is how the relationship starts.
///
/// NULLABLE ON PURPOSE. The column only means anything for a BUILDING_OWNER;
/// every staff row carries NULL. And on the client side NULL is read as
/// CONTRACTED, because every account that existed before this column did was a
/// contracted customer — backfilling them to CONTRACTED would have been a
/// data migration, whereas reading NULL as the old behaviour keeps the existing
/// portal working untouched the moment this ships.
enum ClientType {
  CONTRACTED
  NON_CONTRACTED
}

enum SLATier {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum ElevatorStatus {
  OPERATIONAL
  SERVICE_REQUIRED
  ANOMALY_DETECTED
  CRITICAL_SHUTDOWN
  OFFLINE
}

enum ElevatorBrand {
  OTIS
  SCHINDLER
  THYSSENKRUPP
  MITSUBISHI
  HITACHI
  KONE
  OTHER
}

enum MotorType {
  AC_GEARED
  AC_GEARDLESS
  DC_GEARED
  HYDRAULIC
  OTHER
}

enum ControllerType {
  MICROPROCESSOR
  PLC
  RELAY_LOGIC
  FULLY_DIGITAL
  OTHER
}

enum MaintenanceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  BY_USAGE_CYCLES
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  /// The technician has finished on site and filed his report; the office has
  /// not yet accepted it.
  ///
  /// Distinct from COMPLETED on purpose. Between the two there is a person
  /// reading a report, and a board that cannot tell "done" from "done and
  /// checked" hides the one queue that still needs working through.
  ///
  /// It is also deliberately *not* an open status for dispatch. The job has
  /// left the technician's hands, so he is free for the next one — see
  /// `OPEN_ASSIGNMENT_STATUSES` in `src/lib/dispatch/auto-assign.ts`.
  PENDING_APPROVAL
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
  CRITICAL
}

enum WorkOrderType {
  PREVENTIVE
  PREDICTIVE
  CORRECTIVE
  EMERGENCY
  INSPECTION
}

/// Où en est une facture dans la vie d'une pièce comptable.
///
/// TROIS ÉTATS, ET LE TROISIÈME N'EST PAS DÉCORATIF
/// `CANCELLED` existe parce que le modèle interdit deux factures vivantes pour
/// un même bon (`Invoice.workOrderId` est unique) : refaire une facture veut
/// donc nécessairement dire annuler la première. Sans cet état, une facture
/// fausse resterait éternellement « émise » et réclamerait un montant que
/// personne ne doit.
///
/// IL N'Y A PAS DE « PARTIELLEMENT PAYÉE », ET C'EST DÉLIBÉRÉ
/// Le schéma ne porte ni TVA, ni taux, ni échéance, parce que le régime n'est
/// pas tranché — le commentaire du modèle le dit. Un encaissement partiel
/// demanderait un journal des règlements, un lettrage et un reste dû ; trois
/// états binaires suffisent à répondre à la seule question qu'un registre pose
/// aujourd'hui : « celle-ci est-elle encore due ? ».
enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

enum AlertSeverity {
  INFO
  WARNING
  ANOMALY
  CRITICAL
  EMERGENCY
}

enum ComponentType {
  TRACTION_MOTOR
  BRAKE_ASSEMBLY
  DOOR_OPERATOR
  STEEL_ROPES
  GUIDE_SHOES
  CONTROLLER_BOARD
  COUNTERWEIGHT
  CABIN
  HYDRAULIC_UNIT
  SAFETY_GEAR
  BUFFER
  OTHER
}

enum InspectionCheckResult {
  PASS
  FAIL
  NEEDS_ATTENTION
  NOT_APPLICABLE
}

/// Whether a field technician can be sent to a job.
///
/// Carried by `User.status`. Only meaningful for `FIELD_TECHNICIAN` rows —
/// an administrator or a building owner holds at the default and nothing reads
/// it — but it lives on `User` because that is the table a dispatch decision
/// selects from, and a separate technician table would be a join for one
/// column.
///
/// Declared in *availability order*: AVAILABLE and ON_JOB are both
/// dispatchable (a technician already on a job can still be queued behind it);
/// OFF_DUTY and ON_LEAVE are not. The roster filter relies on that split
/// rather than on an inline list at the call site.
enum TechnicianStatus {
  AVAILABLE
  ON_JOB
  OFF_DUTY
  ON_LEAVE
}

/// Les compétences qu'un technicien de maintenance peut porter.
///
/// Un vocabulaire fermé plutôt que du texte libre. Le texte libre se remplit
/// avec « hydraulique », « Hydraulique » et « hydrolique », et interdit alors
/// toute question du genre « qui sait faire de l'hydraulique ? » — or c'est
/// exactement la question qu'on pose en répartissant une panne. Ajouter une
/// compétence demandera une modification de ce schéma ; c'est le prix d'un
/// vocabulaire qui veut dire quelque chose.
enum TechnicianSkill {
  /// Circuits, groupes et vérins hydrauliques.
  HYDRAULIC
  /// Variateurs, armoires de commande, capteurs et câblage.
  ELECTRONICS
  /// Mécanique générale : réducteurs, freins, guidage.
  MECHANICS
  /// Câbles, suspendions, parachute et limiteur de vitesse.
  ROPES
  /// Portes palières et cabine, automatismes d'ouverture.
  DOORS
  /// Régulation, nivellement et logique de commande.
  CONTROL_SYSTEMS
}

enum PredictiveRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Where a client-reported fault has reached in the resolution pipeline.
///
/// Declared in *pipeline order*, not alphabetically: the progress bar maps
/// these to 25 / 50 / 75 / 100 and relies on that ordering (see
/// `incidentProgress` in `src/lib/incidents/progress.ts`).
///
/// RESOLVED_BY_CLIENT sits last on purpose. It is a terminal state reached by
/// the customer working through the error code's own guidance — no technician
/// is involved and no work order is raised — so it is "finished", but it is
/// *finished without us*. The admin board keeps its own badge for it so a
/// self-resolved fault is never counted as validated work.
enum IncidentStatus {
  ESCALATED
  TECHNICIAN_ASSIGNED
  IN_PROGRESS
  CLOSED
  RESOLVED_BY_CLIENT
}

/// How a reported fault position was arrived at.
///
/// Stored beside the coordinates rather than inferred from them, because the
/// two cases mean genuinely different things to whoever reads the record later.
/// `GPS` is a measurement — the reporter's own device said they were there.
/// `SITE` is an assumption — the device gave nothing, so the building's
/// registered address was used instead. Without the distinction a dispatcher
/// reads a fallback pin as evidence an occupant stood at that spot.
///
/// The position is context, never the location of record. A building's address
/// is the fixed, permanent answer to "where is this lift"; this is only ever
/// "where was the person who told us about it".
enum ReportedPositionSource {
  GPS
  SITE
}

/// L'urgence déclarée d'une demande de pièce.
///
/// Deux valeurs, et ce sont celles du métier : l'appareil est arrêté et il faut
/// la pièce pour le remettre en service, ou bien la pièce est fatiguée et le
/// remplacement s'inscrit dans la prochaine visite. Il n'y a pas de degré
/// intermédiaire — une pièce est nécessaire maintenant ou elle peut attendre, et
/// une troisième valeur ne servirait qu'à ne pas choisir.
enum PartUrgency {
  IMMEDIATE
  PREVENTIVE
}

/// Où en est une demande de pièce.
///
/// `FULFILLED` n'est pas « validée » : c'est la pièce posée. La distinction
/// compte, parce que les deux moments sont séparés par une commande et une
/// livraison, souvent de plusieurs semaines — et une demande validée qu'on
/// croit posée est une pièce que personne n'ira chercher.
enum PartRequirementStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

// ─── USERS & AUTH ───────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String   @map("password_hash")
  role          UserRole
  /// Contracted or not. Only meaningful on a BUILDING_OWNER row; NULL on staff
  /// and read as CONTRACTED on a client. See the enum's doc comment.
  clientType    ClientType? @map("client_type")
  phone         String?

  /// L'adresse du client lui-même — siège, facturation — et non celle de ses
  /// immeubles.
  ///
  /// Les deux existent et ne se confondent pas : `Building.address` est l'endroit
  /// où l'on envoie un technicien, celle-ci est l'endroit où l'on envoie une
  /// facture. Un gestionnaire peut avoir son siège en centre-ville et dix
  /// machines réparties dans la wilaya ; recopier l'un dans l'autre donnerait
  /// soit des factures adressées à une machinerie, soit des interventions
  /// envoyées à un bureau.
  ///
  /// Nullable : un client non contractuel n'a pas de dossier, et l'ouverture
  /// d'un compte ne doit pas être bloquée par une adresse qu'on n'a pas encore.
  address       String?

  avatarUrl     String?  @map("avatar_url")
  isActive      Boolean  @default(true) @map("is_active")
  /// Whether this technician can be dispatched. Defaults to AVAILABLE so the
  /// column is safe to add to a populated table: existing rows become
  /// dispatchable, which is what they were before the column existed.
  status        TechnicianStatus @default(AVAILABLE)

  /// Les compétences déclarées de ce technicien.
  ///
  /// Vide est un état normal, et non une donnée manquante : un nouvel embauché
  /// n'a rien déclaré tant qu'on ne le lui a pas demandé, et un compte de
  /// bureau — administrateur, responsable — n'en aura jamais. C'est pourquoi
  /// c'est un tableau à défaut vide et non une colonne obligatoire : exiger une
  /// compétence bloquerait la création d'un gestionnaire.
  specialties   TechnicianSkill[] @default([]) @map("specialties")

  /// Le secteur habituel de ce technicien.
  ///
  /// Une indication pour le bureau, pas une règle : elle ne filtre aucune
  /// affectation et n'empêche aucun envoi ailleurs. La modéliser en relation
  /// aurait demandé une table de secteurs, un découpage géographique du
  /// territoire et une règle de répartition — un autre produit. Ici, c'est ce
  /// qu'un responsable lit avant d'envoyer quelqu'un : « il connaît la ville ».
  defaultZone   String?           @map("default_zone")

  /// Where this account's phone last said it was, and when it said so.
  ///
  /// Written only by the technician portal, from the technician's own device,
  /// while they are on shift — never by an administrator and never on anyone
  /// else's behalf. That is the whole point of the column: a position an office
  /// could type in would be worth nothing as a distance, and a dispatcher
  /// reading it has to be able to trust that it came off the phone.
  ///
  /// All three are NULL until the device first reports: location refused, a
  /// page served over plain HTTP (no `isSecureContext`), or an account that
  /// has never opened the portal. Every one of those is a normal state, not an
  /// error, and the admin screens say "position inconnue" rather than falling
  /// back to the site's own coordinates and inventing a distance.
  ///
  /// Deliberately a *last known* position rather than a trail: one row per
  /// person, overwritten, with no history. A trail would turn a
  /// "is he nearly there" readout into a movement log of named employees,
  /// which is a different product and a different conversation.
  lastLatitude   Float?    @map("last_latitude")
  lastLongitude  Float?    @map("last_longitude")
  lastPositionAt DateTime? @map("last_position_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  assignedWorkOrders   WorkOrder[]       @relation("TechnicianWorkOrders")
  createdWorkOrders    WorkOrder[]       @relation("CreatorWorkOrders")
  ownedBuildings       Building[]
  inspectionReports    InspectionReport[]
  alerts               Alert[]
  notifications        Notification[]
  sessions             Session[]

  /// Corrections this account made to reports awaiting approval — see
  /// `WorkOrderRevision`. Named, unlike the unqualified relations above,
  /// because `User` already carries two roles pointing at `WorkOrder` and a
  /// third unlabelled edge would have to be guessed at.
  workOrderRevisions   WorkOrderRevision[] @relation("WorkOrderRevisionAuthor")

  /// Invoices billed *to* this customer account. Named for the same reason as
  /// the line above: `User` already stands on both sides of `WorkOrder`, and an
  /// invoice has two distinct people attached — the one who owes and the one who
  /// issued — so neither edge can go unlabelled.
  invoices             Invoice[]           @relation("ClientInvoices")
  /// Invoices this account issued, when a manager or an administrator closed the
  /// job that produced them.
  issuedInvoices       Invoice[]           @relation("IssuedInvoices")

  /// Les factures dont ce compte a changé l'état — marquées réglées ou
  /// annulées. Troisième arête entre `User` et `Invoice`, donc nommée pour la
  /// même raison que les deux précédentes.
  invoiceStatusChanges Invoice[]           @relation("InvoiceStatusChanges")

  /// Les demandes de pièce que ce compte a ouvertes depuis le terrain.
  partRequestsRaised   PartRequirement[]   @relation("PartRequestsRaised")
  /// Et celles qu'il a arbitrées, quand c'est un compte de bureau.
  partRequestDecisions PartRequirement[]   @relation("PartRequestDecisions")

  // Two distinct roles on the same model, so both need naming: a client
  // account that *reports* a fault is a different person from the field
  // technician who *resolves* it.
  reportedIncidents    IncidentReport[] @relation("ClientIncidents")
  assignedIncidents    IncidentReport[] @relation("TechnicianIncidents")

  /// « Fiche Technique » forms this account submitted. A client fills one in
  /// per installation; staff may submit on a client's behalf from the admin
  /// board, in which case `clientId` is that client's id, not theirs.
  technicalSheets      TechnicalSheet[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

// ─── BUILDINGS & ELEVATOR ASSETS ────────────────────────────

model Building {
  id            String    @id @default(cuid())
  name          String
  address       String
  city          String
  state         String?
  zipCode       String?   @map("zip_code")
  country       String    @default("US")
  contactPerson String    @map("contact_person")
  contactEmail  String?   @map("contact_email")
  contactPhone  String?   @map("contact_phone")
  slaTier       SLATier   @default(STANDARD) @map("sla_tier")
  latitude      Float?
  longitude     Float?

  /// Radius, in metres, within which a technician's check-in is accepted here.
  ///
  /// Per site rather than one constant for the fleet, because a fixed radius is
  /// wrong in both directions: 100 m locks a technician out of an industrial
  /// estate whose machine room sits 400 m inside the gate, and the same 100 m
  /// waves through one parked at the café opposite a small apartment block.
  ///
  /// NULL means nobody has configured this site yet. The application falls back
  /// to `DEFAULT_GEOFENCE_RADIUS_M` rather than refusing, so a building created
  /// through the API keeps working before an administrator has been near it.
  geofenceRadiusM Int?    @map("geofence_radius_m")

  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relationships
  elevators     Elevator[]
  ownerId       String?   @map("owner_id")
  owner         User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Every BUILDING_OWNER read is filtered on `owner_id` (see
  // `buildingScopeFor` in src/lib/api/guard.ts), so this is a hot filter, not
  // an incidental relation.
  @@index([ownerId])
  @@map("buildings")
}

model Elevator {
  id               String         @id @default(cuid())
  elevatorCode     String         @unique @map("elevator_code")
  buildingId       String         @map("building_id")
  brand            ElevatorBrand
  model            String
  serialNumber     String?        @map("serial_number")
  installationDate DateTime?      @map("installation_date")
  motorType        MotorType      @map("motor_type")
  maxPayloadKg     Float          @map("max_payload_kg")
  controllerType   ControllerType @map("controller_type")
  floorsServed     Int            @map("floors_served")
  status           ElevatorStatus @default(OPERATIONAL)
  operatingHours   Float          @default(0) @map("operating_hours")
  doorCycleCount   Int            @default(0) @map("door_cycle_count")
  brakeActuations  Int            @default(0) @map("brake_actuations")
  lastMaintenance  DateTime?      @map("last_maintenance")
  nextMaintenance  DateTime?      @map("next_maintenance")
  overallHealth    Float          @default(100) @map("overall_health")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relationships
  building         Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  components       ElevatorComponent[]
  telemetryStreams  TelemetryStream[]
  maintenanceSchedules MaintenanceSchedule[]
  workOrders       WorkOrder[]
  alerts           Alert[]
  predictiveScores PredictiveScore[]
  inspectionReports InspectionReport[]
  incidents        IncidentReport[]
  latestTelemetry  TelemetrySnapshot? @relation("LatestTelemetry")

  /// The « Fiche Technique » for this unit, when one has been submitted. At
  /// most one per elevator — the unique constraint on the other side is what
  /// enforces it.
  technicalSheet   TechnicalSheet?

  @@index([buildingId])
  @@index([status])
  @@map("elevators")
}

model ElevatorComponent {
  id            String        @id @default(cuid())
  elevatorId    String        @map("elevator_id")
  componentType ComponentType @map("component_type")
  name          String
  manufacturer  String?
  partNumber    String?       @map("part_number")
  installedDate DateTime?     @map("installed_date")
  expectedLifeHours Float?    @map("expected_life_hours")
  currentLifeHours  Float     @default(0) @map("current_life_hours")
  remainingUsefulLife Float  @default(100) @map("remaining_useful_life")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relationships
  elevator        Elevator        @relation(fields: [elevatorId], references: [id], onDelete: Cascade)
  predictiveScores PredictiveScore[]
  workOrders      WorkOrder[]

  @@index([elevatorId])
  @@unique([elevatorId, componentType])
  @@map("elevator_components")
}

// ─── TELEMETRY & IOT ────────────────────────────────────────

model TelemetryStream {
  id              String    @id @default(cuid())
  elevatorId      String    @map("elevator_id")
  timestamp       DateTime  @default(now())
  motorVibrationMmS Float? @map("motor_vibration_mm_s")
  motorTemperatureC Float? @map("motor_temperature_c")
  doorCycleCount  Int?      @map("door_cycle_count")
  doorSpeedMs     Float?    @map("door_speed_ms")
  cabinLoadKg     Float?    @map("cabin_load_kg")
  levelingOffsetMm Float?  @map("leveling_offset_mm")
  operatingHours  Float?    @map("operating_hours")
  brakeActuations Int?      @map("brake_actuations")
  supplyVoltageV  Float?    @map("supply_voltage_v")
  currentDrawA    Float?    @map("current_draw_a")
  metadata        Json?     // Additional sensor data

  // Relationships
  elevator        Elevator  @relation(fields: [elevatorId], references: [id], onDelete: Cascade)

  @@index([elevatorId, timestamp])
  @@index([timestamp])
  @@map("telemetry_streams")
}

model TelemetrySnapshot {
  id              String    @id @default(cuid())
  elevatorId      String    @unique @map("elevator_id")
  motorVibrationMmS Float? @map("motor_vibration_mm_s")
  motorTemperatureC Float? @map("motor_temperature_c")
  doorCycleCount  Int?      @map("door_cycle_count")
  doorSpeedMs     Float?    @map("door_speed_ms")
  cabinLoadKg     Float?    @map("cabin_load_kg")
  levelingOffsetMm Float?  @map("leveling_offset_mm")
  operatingHours  Float?    @map("operating_hours")
  brakeActuations Int?      @map("brake_actuations")
  supplyVoltageV  Float?    @map("supply_voltage_v")
  currentDrawA    Float?    @map("current_draw_a")
  lastUpdated     DateTime  @default(now()) @map("last_updated")

  elevator        Elevator  @relation("LatestTelemetry", fields: [elevatorId], references: [id], onDelete: Cascade)

  @@map("telemetry_snapshots")
}

// ─── THRESHOLD RULES ────────────────────────────────────────

model ThresholdRule {
  id            String        @id @default(cuid())
  metricName    String        @map("metric_name")
  warningMin    Float?        @map("warning_min")
  warningMax    Float?        @map("warning_max")
  criticalMin   Float?        @map("critical_min")
  criticalMax   Float?        @map("critical_max")
  description   String?
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")

  alerts        Alert[]

  @@unique([metricName])
  @@map("threshold_rules")
}

// ─── ALERTS ─────────────────────────────────────────────────

model Alert {
  id              String        @id @default(cuid())
  elevatorId      String        @map("elevator_id")
  thresholdRuleId String?       @map("threshold_rule_id")
  severity        AlertSeverity
  title           String
  message         String
  metricName      String?       @map("metric_name")
  metricValue     Float?        @map("metric_value")
  isAcknowledged  Boolean       @default(false) @map("is_acknowledged")
  acknowledgedBy  String?       @map("acknowledged_by")
  acknowledgedAt  DateTime?     @map("acknowledged_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  resolvedAt      DateTime?     @map("resolved_at")

  // Relationships
  elevator        Elevator      @relation(fields: [elevatorId], references: [id], onDelete: Cascade)
  thresholdRule   ThresholdRule? @relation(fields: [thresholdRuleId], references: [id], onDelete: SetNull)
  acknowledgedByUser User?      @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  workOrders      WorkOrder[]

  @@index([elevatorId, severity])
  @@index([createdAt])
  @@map("alerts")
}

// ─── PREDICTIVE AI SCORES ──────────────────────────────────

model PredictiveScore {
  id               String             @id @default(cuid())
  elevatorId       String             @map("elevator_id")
  componentId      String?            @map("component_id")
  componentType    ComponentType      @map("component_type")
  riskLevel        PredictiveRiskLevel @map("risk_level")
  riskScore        Float              @map("risk_score") // 0-100
  remainingUsefulLifePercent Float     @map("remaining_useful_life_percent")
  predictedFailureDate DateTime?      @map("predicted_failure_date")
  confidence       Float              @default(0) // 0-1
  modelVersion     String?            @map("model_version")
  features         Json?              // Input features used
  recommendations  String[]
  createdAt        DateTime           @default(now()) @map("created_at")
  // Upserts reuse the existing row, so `createdAt` only records the *first*
  // time a component was scored. Without `updatedAt` there was no way to tell
  // how stale a stored score was.
  updatedAt        DateTime           @updatedAt @map("updated_at")

  // Relationships
  elevator    Elevator             @relation(fields: [elevatorId], references: [id], onDelete: Cascade)
  component   ElevatorComponent?   @relation(fields: [componentId], references: [id])

  @@unique([elevatorId, componentType])
  @@index([riskLevel])
  @@map("predictive_scores")
}

// ─── MAINTENANCE SCHEDULING ────────────────────────────────

model MaintenanceSchedule {
  id            String               @id @default(cuid())
  elevatorId    String               @map("elevator_id")
  title         String
  description   String?
  frequency     MaintenanceFrequency
  cycleThreshold Int?                @map("cycle_threshold") // For BY_USAGE_CYCLES
  checklistItems Json                @map("checklist_items") // Array of checklist items
  nextDueDate   DateTime             @map("next_due_date")
  lastCompleted DateTime?            @map("last_completed")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  // Relationships
  elevator      Elevator             @relation(fields: [elevatorId], references: [id], onDelete: Cascade)
  workOrders    WorkOrder[]

  @@index([elevatorId, nextDueDate])
  @@map("maintenance_schedules")
}

// ─── WORK ORDERS ────────────────────────────────────────────

model WorkOrder {
  id              String            @id @default(cuid())
  orderNumber     String            @unique @map("order_number")
  title           String
  description     String?
  type            WorkOrderType
  priority        WorkOrderPriority @default(MEDIUM)
  status          WorkOrderStatus   @default(OPEN)

  elevatorId      String            @map("elevator_id")
  componentId     String?           @map("component_id")
  scheduleId      String?           @map("schedule_id")
  alertId         String?           @map("alert_id") @unique
  assignedToId    String?           @map("assigned_to_id")
  createdById     String?           @map("created_by_id")

  estimatedHours  Float?            @map("estimated_hours")
  actualHours     Float?            @map("actual_hours")
  partsReplaced   Json?             @map("parts_replaced") // Array of {name, partNumber, qty}
  notes           String?
  photoUrls       String[]          @map("photo_urls")
  signatureUrl    String?           @map("signature_url")

  /// Whether this job carries payable work — a part supplied, a callout
  /// outside the maintenance contract.
  ///
  /// Defaults to false, and false is the honest default: most visits are
  /// covered by a contract, and a flag that defaulted to "billable" would turn
  /// every forgotten checkbox into an invoice sent to a client.
  isBillable      Boolean           @default(false) @map("is_billable")

  /// The total to bill, in Algerian dinars, as the technician entered it.
  ///
  /// `Decimal(12, 2)` and not `Float`: a currency amount has to be exact, and a
  /// binary float that renders 12345.6 as 12345.599999999999 is a number nobody
  /// can be asked to pay. DZD has no subdivision in practice; the scale of 2 is
  /// kept so the column does not have to change the day a price list arrives
  /// with centimes.
  ///
  /// Null is meaningful here and is not zero. A non-billable job leaves it
  /// null, and so does a billable job whose amount the technician left blank —
  /// an incomplete report the office fills in while validating it.
  ///
  /// No VAT column and no invoice number yet: those belong to the invoicing
  /// work, and a numbering scheme invented here would produce numbers that have
  /// to be thrown away.
  invoiceAmount   Decimal?          @db.Decimal(12, 2) @map("invoice_amount")

  /// When the technician filed his report — i.e. when this order entered
  /// PENDING_APPROVAL. Cleared if the office sends it back for correction.
  ///
  /// Kept apart from `completedAt` because the two are different facts and only
  /// one of them is true at this stage: the site work is over, the order is
  /// not. It is also the only column an approval queue can honestly sort by —
  /// "en attente depuis mardi" is what gets a pending report read.
  reportSubmittedAt DateTime?       @map("report_submitted_at")

  scheduledDate   DateTime?         @map("scheduled_date")
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")

  /// When the technician pressed « J'ai pointé mon arrivée » on site.
  ///
  /// Deliberately a separate column from `startedAt`, which is the moment they
  /// began working. The two answer different questions and disagree in both
  /// directions: a technician can open the job from the van and arrive twenty
  /// minutes later, or walk in and start immediately. When a client rings to
  /// ask "is anyone actually here yet", `arrivedAt` is the only honest answer
  /// — `startedAt` would have said yes from the car park.
  arrivedAt       DateTime?         @map("arrived_at")

  /// What the technician found on arrival — access arrangements, the name of
  /// whoever handed over the keys, a parking restriction. Optional: check-in
  /// must never be blocked by a text field, or it stops being used.
  checkInNotes    String?           @map("check_in_notes")

  /// Where the technician actually was when they checked in, and how far that
  /// was from the site.
  ///
  /// Kept as evidence rather than for the running of the application: the gate
  /// reads them once, at the moment of the check-in, and nothing else ever
  /// consults them. They are stored because the reason a geofence exists is to
  /// be able to answer "was he actually there?" weeks later, and a verdict
  /// nobody recorded is not an answer.
  ///
  /// All three are NULL whenever the position could not be established — see
  /// `evaluateGeofence`. That is not an error state: it is the normal outcome
  /// for a site we have never geolocated, or for a technician in a basement.
  checkInLatitude  Float?           @map("check_in_latitude")
  checkInLongitude Float?           @map("check_in_longitude")
  /// Metres from the site centre, rounded. NULL when either end is unknown.
  checkInDistanceM Int?             @map("check_in_distance_m")

  /// Where the fault was reported from — the client's answer to "where is it",
  /// not the technician's answer to "where am I".
  ///
  /// A copy of the same three columns on `IncidentReport`, written in the same
  /// transaction. It exists because a work order is what a technician actually
  /// opens in the field, and making them join back through the incident to
  /// learn where to go would be a join on every list that draws a job.
  ///
  /// NOT interchangeable with `checkIn*` above, and the two are never merged:
  /// this is where the *customer* said the problem was, hours or days before
  /// anyone drove there; those are where the *engineer* was when they arrived.
  /// A wide gap between them is exactly the thing a dispatcher wants to see,
  /// and averaging them would destroy it.
  reportedLatitude       Float?                   @map("reported_latitude")
  reportedLongitude      Float?                   @map("reported_longitude")
  reportedPositionSource ReportedPositionSource?  @map("reported_position_source")

  /// What actually happened when this job was sent to the technician's WhatsApp.
  ///
  /// WHY THESE EXIST AT ALL
  /// Sending the job out of band must never fail the dispatch: the assignment is
  /// committed before the message is attempted, and a WhatsApp gateway that is
  /// down cannot be allowed to turn a successful dispatch into an error the
  /// manager retries. That much is a rule about control flow. These three
  /// columns are the other half of it, and the half that is easy to skip:
  /// because we swallow the failure, we owe the record of it. Without them,
  /// "the technician was told" and "the gateway was unreachable and nobody was
  /// told" look identical from every screen in the product — right up until he
  /// fails to turn up.
  ///
  /// `whatsappDeliveredAt` NULL with `whatsappAttemptedAt` set is the state that
  /// matters: somebody tried, and the technician was not reached. The admin
  /// board reads exactly that pair.
  ///
  /// NOT A HISTORY
  /// Overwritten on every attempt, one row per job. The question a dispatcher
  /// asks is "was he warned about *this* job", not "how many times did we try",
  /// and an append-only trail of notification attempts is a log, which belongs
  /// in logs. A later failed attempt clears `whatsappDeliveredAt` rather than
  /// leaving the earlier success standing — after a reassignment, the previous
  /// technician's delivery must not read as this one's.
  ///
  /// `whatsappFailure` is a plain `String`, like `Notification.type` below, and
  /// for the same reason: the set of reasons is a diagnostic vocabulary defined
  /// in `src/lib/notifications/whatsapp.ts`, not a business state anything
  /// branches on. An enum would mean a schema migration every time a provider
  /// invents a new way to fail.
  whatsappAttemptedAt DateTime? @map("whatsapp_attempted_at")
  whatsappDeliveredAt DateTime? @map("whatsapp_delivered_at")
  whatsappFailure     String?   @map("whatsapp_failure")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relationships
  elevator        Elevator          @relation(fields: [elevatorId], references: [id], onDelete: Cascade)
  component       ElevatorComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  schedule        MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  alert           Alert?            @relation(fields: [alertId], references: [id], onDelete: SetNull)
  assignedTo      User?             @relation("TechnicianWorkOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("CreatorWorkOrders", fields: [createdById], references: [id], onDelete: SetNull)
  inspectionReports InspectionReport[]
  incident        IncidentReport?
  revisions       WorkOrderRevision[]
  invoice         Invoice?
  /// Les pièces à commander que cette intervention a motivées. Voir
  /// `PartRequirement` : une demande n'est pas un constat.
  partRequirements PartRequirement[]

  @@index([elevatorId, status])
  @@index([assignedToId, status])
  @@index([status, priority])
  @@map("work_orders")
}

/// Une pièce qu'il faut commander, demandée depuis une intervention.
///
/// POURQUOI CE N'EST PAS `WorkOrder.partsReplaced`
/// Les deux parlent de pièces et ne disent pas la même chose. `partsReplaced`
/// est le *constat* : ce que le technicien a posé, écrit à la fin de
/// l'intervention et recopié tel quel dans la facture — il est figé, et c'est ce
/// qui rend une facture opposable.
///
/// Cette table est la *demande* : la pièce qu'il n'avait pas dans le véhicule et
/// qu'il faut se procurer. Elle existe avant l'intervention qui la posera, elle
/// porte une urgence, un demandeur, et une décision du bureau qui peut la
/// refuser. Écrire les deux dans la même colonne obligerait à décider si une
/// ligne « validée » est une pièce posée ou une pièce espérée, et c'est
/// exactement la question à laquelle la facturation doit répondre sans hésiter.
///
/// AUCUN LIEN VERS UN CATALOGUE DE PIÈCES, ET C'EST ASSUMÉ
/// Il n'existe ni table de pièces, ni stock, ni référence fournisseur dans ce
/// produit. La référence et la désignation sont donc du texte libre, saisi par
/// celui qui a la pièce sous les yeux. Créer un catalogue aurait demandé un
/// référentiel, des fournisseurs, des prix et un inventaire — un autre produit,
/// et un référentiel vide en attendant.
model PartRequirement {
  id            String  @id @default(cuid())
  /// Le numéro imprimé, `DP-202609-7KQ4ZP`. Généré par `generatePartRequestNumber`.
  number        String  @unique
  workOrderId   String  @map("work_order_id")
  /// Qui a demandé. Nullable et `SetNull` : le départ d'un salarié ne doit pas
  /// effacer la demande, seulement son attribution.
  requestedById String? @map("requested_by_id")

  // ─── Ce qui est défectueux, et ce qu'il faut ──────────────
  //
  // Les deux sont enregistrés séparément parce qu'ils ne coïncident pas
  // toujours : on remplace souvent un organe complet là où une pièce
  // intermédiaire suffirait, et le bureau a besoin de voir la différence pour
  // arbitrer. Le nom fautif est obligatoire — c'est le diagnostic, et une
  // demande sans diagnostic n'est pas une demande, c'est un message.
  faultyPartName        String  @map("faulty_part_name")
  faultyPartReference   String? @map("faulty_part_reference")
  replacementPartName   String  @map("replacement_part_name")
  replacementPartReference String? @map("replacement_part_reference")
  quantity              Int     @default(1)

  urgency PartUrgency @default(PREVENTIVE)
  /// Les observations du technicien : ce qu'il a mesuré, entendu, constaté.
  notes   String?

  // ─── La décision du bureau ────────────────────────────────
  status           PartRequirementStatus @default(PENDING)
  /// Quand et par qui la décision a été prise. NULL veut dire « personne n'a
  /// encore statué », et non « décision inconnue » : c'est l'état d'une demande
  /// qui attend.
  statusChangedAt  DateTime? @map("status_changed_at")
  statusChangedById String?  @map("status_changed_by_id")
  /// Quand la pièce a été posée. Colonne distincte de `statusChangedAt` : le
  /// passage à `FULFILLED` est la fin de l'histoire, et la date à laquelle on
  /// l'atteint est la seule qu'on cherche six mois plus tard.
  fulfilledAt      DateTime? @map("fulfilled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  /// `Cascade` : une demande de pièce n'a aucun sens détachée de l'intervention
  /// qui l'a motivée. Elle ne porte ni numéro de pièce comptable ni montant —
  /// c'est une note interne, et l'effacer avec son bon n'efface rien d'opposable.
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  requestedBy       User?     @relation("PartRequestsRaised", fields: [requestedById], references: [id], onDelete: SetNull)
  statusChangedBy   User?     @relation("PartRequestDecisions", fields: [statusChangedById], references: [id], onDelete: SetNull)

  /// La seule requête de l'écran : « les demandes de ce bon, du plus récent ».
  @@index([workOrderId, createdAt])
  /// Et celle du tableau du bureau : « ce qui attend une décision ».
  @@index([status, urgency])
  @@map("part_requirements")
}

/// Une facture émise pour un bon de travail clos.
///
/// POURQUOI ELLE RECOPIE TOUT AU LIEU DE LE RELIRE
/// Une facture est un document opposable : celle que le client a reçue doit
/// pouvoir être reproduite à l'identique des années plus tard. Or tout ce
/// qu'elle imprime peut changer — le client change d'adresse, le bon est
/// renommé, un montant est corrigé au bureau, un appareil est renommé. Recalculer
/// le PDF depuis le bon à chaque téléchargement produirait donc, pour la même
/// facture, deux documents différents selon le jour où on l'ouvre ; et personne
/// ne pourrait dire lequel a été envoyé. Les valeurs du document sont donc
/// figées ici, à l'émission, et l'écran de la facture ne consulte jamais le bon.
///
/// Le lien vers le bon reste, lui, pour la navigation et pour l'audit — mais
/// il n'alimente pas le document.
///
/// LA NUMÉROTATION
/// `year` et `sequence` sont la vérité ; `number` en est la forme lisible
/// (`FA-2026-0042`), stockée pour être recherchée et affichée. La séquence est
/// un entier plutôt qu'un compteur déduit du dernier numéro : trier des chaînes
/// zero-paddées fonctionne jusqu'à ce qu'une année dépasse 9999 factures, et
/// « fonctionne jusqu'à » n'est pas une propriété qu'on veut sur un registre.
/// La contrainte `@@unique([year, sequence])` est ce qui garantit qu'aucun
/// numéro n'est attribué deux fois — la route réessaie sur collision.
model Invoice {
  id          String   @id @default(cuid())
  /// La forme imprimée, `FA-2026-0042`.
  number      String   @unique
  year        Int
  sequence    Int

  /// Un bon ne donne qu'une facture. S'il fallait la refaire, l'ancienne serait
  /// annulée et une nouvelle émise — jamais deux factures vivantes pour un bon.
  workOrderId String   @unique

  /// Le compte client facturé, quand il existe. Nullable : un bon peut avoir été
  /// clos pour un occupant sans compte, et la facture reste due.
  clientId    String?  @map("client_id")
  issuedById  String?  @map("issued_by_id")
  issuedAt    DateTime @default(now()) @map("issued_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // ─── Le client, tel qu'il était le jour de l'émission ───
  clientName    String  @map("client_name")
  clientAddress String? @map("client_address")
  clientEmail   String? @map("client_email")
  clientPhone   String? @map("client_phone")

  // ─── Le lieu et l'appareil ───
  buildingName    String @map("building_name")
  buildingAddress String @map("building_address")
  buildingCity    String @map("building_city")
  elevatorCode    String @map("elevator_code")

  // ─── Le bon dont elle découle ───
  orderNumber String         @map("order_number")
  orderTitle  String         @map("order_title")
  orderType   WorkOrderType  @map("order_type")
  completedAt DateTime?      @map("completed_at")

  // ─── Ce qui a été fait et posé ───
  reportNotes   String? @map("report_notes")
  partsReplaced Json?   @map("parts_replaced")

  // ─── Le montant ───
  /// `Decimal(12,2)` comme `WorkOrder.invoiceAmount`, et pour la même raison :
  /// un montant en virgule flottante finit par afficher 12 345,599999.
  ///
  /// Aucune TVA et aucun taux : le régime n'est pas tranché, et une colonne
  /// inventée ici produirait des factures dont le total ne correspond à rien.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("DZD")

  /// L'état de la pièce. Nouvelle colonne : les factures déjà émises prennent
  /// `ISSUED`, qui est ce qu'elles étaient — aucun document existant ne change
  /// de sens rétroactivement.
  ///
  /// Le document lui-même n'est pas réécrit quand l'état change : voir
  /// `statusChangedAt`, et le commentaire de `renderInvoicePdf`.
  status             InvoiceStatus @default(ISSUED)
  /// Quand l'état a été posé. NULL sur une facture restée `ISSUED`, et ce n'est
  /// pas une donnée manquante : c'est la date à laquelle on l'a marquée réglée
  /// ou annulée, qui n'existe pas tant que personne ne l'a fait.
  statusChangedAt    DateTime?     @map("status_changed_at")
  /// Qui l'a posé. Nullable et `SetNull` : le départ d'un salarié ne doit pas
  /// effacer la trace d'un encaissement, il ne doit faire perdre que le nom.
  statusChangedById  String?       @map("status_changed_by_id")

  /// `Restrict`, et non `Cascade` : une facture est une pièce comptable, et
  /// supprimer le bon ne doit pas l'effacer avec lui. C'est ce qui rend
  /// impossible la suppression d'un bon déjà facturé — ce qui est le
  /// comportement voulu, pas un obstacle à contourner.
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  client    User?     @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: SetNull)
  issuedBy  User?     @relation("IssuedInvoices", fields: [issuedById], references: [id], onDelete: SetNull)
  statusChangedBy User? @relation("InvoiceStatusChanges", fields: [statusChangedById], references: [id], onDelete: SetNull)

  /// Le portail client lit cette liste : « mes factures, les plus récentes
  /// d'abord ».
  @@index([clientId, issuedAt])
  /// Le registre, lui, demande « les non réglées de ce trimestre ». Sans cet
  /// index, chaque ouverture du registre trie l'historique complet.
  @@index([status, issuedAt])
  @@index([year, sequence])
  @@map("invoices")
}

/// A change the office made to a report that was already waiting for approval.
///
/// WHY THIS IS A TABLE, WHEN THE COLUMNS ABOVE REFUSE TO BE ONE
/// `whatsappAttemptedAt` and its neighbours are deliberately *not* a history,
/// and the reason is the question they answer: a dispatcher asks "was he warned
/// about this job?", which has one answer and one row. This table answers a
/// different question — "the amount on this invoice is not what the technician
/// wrote; who changed it, and what did he write?" — and that question has no
/// single-row answer. The original figure has to survive the correction, or the
/// correction is indistinguishable from having typed it in the first place,
/// which is exactly the thing a client disputes.
///
/// It is bounded on purpose. A row is written only when an order *already* in
/// `PENDING_APPROVAL` has one of its report fields changed, so this is a ledger
/// of the office's edits to submitted reports and not a general audit log of
/// every write in the product. Editing an open job, dispatching it, or checking
/// in writes nothing here.
///
/// Values are stored as text, not as the columns' own types. A revision row
/// records a historical fact ("this read 18500, it now reads 185000"), and a
/// fact about the past must not change shape when a column's type does. The one
/// place they are read back — the revision timeline on the work-order page —
/// prints them, so the string is the honest storage.
model WorkOrderRevision {
  id          String   @id @default(cuid())
  workOrderId String   @map("work_order_id")

  /// Who made the change. Nullable, and null is meaningful: the account may be
  /// deleted years later, and the correction has to outlive the person who made
  /// it. `onDelete: SetNull` keeps the record and loses only the attribution —
  /// the alternative, cascading the revision away, would let deleting a user
  /// quietly rewrite a client's billing history.
  authorId    String?  @map("author_id")

  /// Which field was corrected. `invoiceAmount`, `isBillable`, `notes`,
  /// `partsReplaced` — and `status`, used for the single most important entry
  /// on this table: a report the office sent back for correction.
  field       String

  /// The value before and after. Null on either side is real: a description
  /// that was empty and is now written, or an amount that was set and is now
  /// cleared because the job turned out to be covered by the contract.
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")

  /// A remark the author chose to attach. Carries the reason a report was
  /// refused, which is the whole message the technician reads.
  note        String?

  createdAt   DateTime @default(now()) @map("created_at")

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author      User?     @relation("WorkOrderRevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// The only query there is: every revision of one order, oldest first.
  @@index([workOrderId, createdAt])
  @@map("work_order_revisions")
}

// ─── INSPECTION REPORTS ─────────────────────────────────────

model InspectionReport {
  id            String   @id @default(cuid())
  workOrderId   String   @map("work_order_id")
  technicianId  String   @map("technician_id")
  elevatorId    String   @map("elevator_id")
  reportNumber  String   @unique @map("report_number")
  title         String
  summary       String?
  overallResult InspectionCheckResult @map("overall_result")
  signatures    Json?    // Digital signature data
  submittedAt   DateTime @default(now()) @map("submitted_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relationships
  workOrder     WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technician    User       @relation(fields: [technicianId], references: [id])
  elevator      Elevator   @relation(fields: [elevatorId], references: [id])
  checkItems    InspectionCheckItem[]

  // The list endpoint paginates with `ORDER BY submitted_at DESC` and filters
  // on technician (own reports), elevator (owner scoping) or work order
  // (single report lookup). None of these were indexed, so every page load
  // was a sequential scan plus sort over the whole history.
  @@index([submittedAt])
  @@index([technicianId, submittedAt])
  @@index([elevatorId])
  @@index([workOrderId])
  @@map("inspection_reports")
}

model InspectionCheckItem {
  id            String   @id @default(cuid())
  reportId      String   @map("report_id")
  checkName     String   @map("check_name")
  description   String?
  result        InspectionCheckResult
  notes         String?
  photoUrl      String?  @map("photo_url")
  measuredValue Float?   @map("measured_value")
  unit          String?

  report        InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("inspection_check_items")
}

// ─── NOTIFICATIONS ──────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   // alert, work_order, system
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── ERROR CODES (CLIENT SELF-SERVICE) ──────────────────────

/// A controller fault code, written for a *non-technician*.
///
/// This is the first line of the client portal: a tenant reads the code off
/// the controller display, looks it up, and follows `solution`. The copy here
/// is therefore customer-facing prose, unlike `Alert.message`, which is
/// written for staff reviewing a dashboard.
///
/// `audioUrl` is not decoration. A meaningful share of building occupants
/// cannot read comfortably, so the accessibility mode plays this aloud
/// instead of rendering `solution` as text — see the client portal's
/// `speechSynthesis` path.
model ErrorCode {
  id          String   @id @default(cuid())
  code        String   @unique // "E-101", shown verbatim on the controller
  title       String
  description String
  solution    String // ordered steps, newline separated
  audioUrl    String?  @map("audio_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  incidents   IncidentReport[]

  @@index([isActive])
  @@map("error_codes")
}

// ─── CLIENT INCIDENTS ───────────────────────────────────────

/// A fault reported by a building's occupant, and its route to resolution.
///
/// Deliberately a separate model from `WorkOrder`, because the two answer
/// different questions. A work order is *our* unit of labour: who is going,
/// with what, by when. An incident is the *customer's* unit of experience:
/// something broke, here is what I did about it. Most incidents never become
/// work at all — the occupant reads the error code, follows the guidance and
/// the thing is fixed (`RESOLVED_BY_CLIENT`).
///
/// The link between them is a nullable one-to-one (`workOrderId`), created
/// only when escalation actually needs a technician. Forcing every reported
/// fault to mint a work order would flood the dispatch board with jobs that
/// a tenant resolved by power-cycling the controller.
model IncidentReport {
  id               String         @id @default(cuid())
  incidentNumber   String         @unique @map("incident_number")
  elevatorId       String         @map("elevator_id")
  clientId         String         @map("client_id")
  errorCodeId      String?        @map("error_code_id")
  status           IncidentStatus @default(ESCALATED)
  isDirectTransfer Boolean        @default(false) @map("is_direct_transfer")
  workOrderId      String?        @unique @map("work_order_id")
  technicianId     String?        @map("technician_id")
  notes            String?
  audioNoteUrl     String?        @map("audio_note_url")

  /// Where the fault was reported from, and how certain that is.
  ///
  /// A *snapshot*, taken once when the report is filed and never updated. That
  /// is what makes the copy on `WorkOrder` safe: the two rows are written in
  /// the same transaction and neither is ever revised afterwards, so there is
  /// nothing for them to disagree about. `reportedPositionSource` is what says
  /// whether this is the reporter's own device or the building's address
  /// standing in for it — see `ReportedPositionSource`.
  ///
  /// All three are NULL only for reports filed before this existed, or for a
  /// building that has never been geolocated. The map draws a pin for neither;
  /// the site's own pin still carries the incident count.
  reportedLatitude       Float?                   @map("reported_latitude")
  reportedLongitude      Float?                   @map("reported_longitude")
  reportedPositionSource ReportedPositionSource?  @map("reported_position_source")

  resolvedAt       DateTime?      @map("resolved_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relationships
  elevator         Elevator   @relation(fields: [elevatorId], references: [id], onDelete: Cascade)
  client           User       @relation("ClientIncidents", fields: [clientId], references: [id], onDelete: Cascade)
  errorCode        ErrorCode? @relation(fields: [errorCodeId], references: [id], onDelete: SetNull)
  workOrder        WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  technician       User?      @relation("TechnicianIncidents", fields: [technicianId], references: [id], onDelete: SetNull)

  // The admin board filters by status and sorts by recency; the client portal
  // asks "my own incidents" and the technician queue "assigned to me". Each of
  // those is a leading-equality + sort, which is exactly what these cover.
  @@index([status, createdAt])
  @@index([clientId, status])
  @@index([technicianId, status])
  @@index([elevatorId, status])
  @@index([createdAt])
  @@map("incident_reports")
}

// ─── FICHE TECHNIQUE (clients « Sans Contrat ») ─────────────

/// The digitised « Fiche Technique » from *Conception Etude & Maintenance des
/// Ascenseurs*.
///
/// WHY SO MUCH IS NULLABLE
/// This form exists for clients we have no contract with — no prior file, no
/// surveyed equipment. It is filled in from what the caretaker or the owner can
/// read off the installation, so requiring the full technical breakdown would
/// guarantee an empty form. Only the four fields in `REQUIRED_FIELD_NAMES`
/// (`src/lib/technical-sheets/fields.ts`) are enforced; every technical column
/// is nullable on purpose, and the maintenance team completes them on site.
///
/// ON DELETE BEHAVIOUR IS NOT COSMETIC HERE
/// `elevator` is `SetNull`, and that is deliberate. `InspectionReport.elevator`
/// was declared without a rule, so it defaulted to RESTRICT and made the whole
/// graph undeletable — the seed failed on it with a foreign-key violation.
/// A sheet that describes an installation we have since retired is still worth
/// keeping, so the link is dropped rather than the row.
model TechnicalSheet {
  id         String  @id @default(cuid())
  elevatorId String? @unique @map("elevator_id")
  clientId   String  @map("client_id")

  // ─── Obligatoires ─────────────────────────────────────────
  /// Four fields the client always knows. See `REQUIRED_FIELD_NAMES`.
  clientName     String @map("client_name")
  location       String
  weightCapacity String @map("weight_capacity")
  numberOfFloors String @map("number_of_floors")

  // ─── Optionnels — identification ──────────────────────────
  serialNumber     String? @map("serial_number")
  installationDate String? @map("installation_date")
  technicianName   String? @map("technician_name")

  // ─── Optionnels — machinerie ──────────────────────────────
  machineType     String? @map("machine_type")
  mainBreaker     String? @map("main_breaker")
  plugSwitch      String? @map("plug_switch")
  speedLimiter    String? @map("speed_limiter")
  motorType       String? @map("motor_type")
  speedVariator   String? @map("speed_variator")
  arlCard         String? @map("arl_card")
  inverter        String?
  brakingResistor String? @map("braking_resistor")
  chassis         String?
  tractionRope    String? @map("traction_rope")

  // ─── Optionnels — toit de cabine ──────────────────────────
  inspectionBox       String? @map("inspection_box")
  lubricator          String?
  overloadContactType String? @map("overload_contact_type")
  shoeGarnitureType   String? @map("shoe_garniture_type")
  doorOperatorType    String? @map("door_operator_type")
  mobileCam           String? @map("mobile_cam")
  impulsors           String?
  emergencyLight      String? @map("emergency_light")
  fan                 String?

  // ─── Optionnels — cabine et palier ────────────────────────
  barreaudage       String?
  limitSwitch       String? @map("limit_switch")
  buttonStationType String? @map("button_station_type")
  lighting          String?
  cabinDoorType     String? @map("cabin_door_type")
  display           String?
  photocellType     String? @map("photocell_type")
  soundSignal       String? @map("sound_signal")
  handrail          String?
  landingButtonType String? @map("landing_button_type")
  landingDoorType   String? @map("landing_door_type")

  // ─── Optionnels — gaine et cuve ───────────────────────────
  shaftStop               String? @map("shaft_stop")
  shaftLighting           String? @map("shaft_lighting")
  counterweightShoes      String? @map("counterweight_shoes")
  endLimitCam             String? @map("end_limit_cam")
  pendantBrackets         String? @map("pendant_brackets")
  cabinGuideRails         String? @map("cabin_guide_rails")
  counterweightGuideRails String? @map("counterweight_guide_rails")
  shockAbsorbers          String? @map("shock_absorbers")
  tensionPulley           String? @map("tension_pulley")
  parachuteType           String? @map("parachute_type")
  travelHeight            String? @map("travel_height")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  elevator Elevator? @relation(fields: [elevatorId], references: [id], onDelete: SetNull)
  client   User      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
  @@map("technical_sheets")
}
